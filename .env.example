# Copy to .env (gitignored — never commit the real file) and fill in real
# values before `docker compose up` or any `docker compose run jobs ...`.
# See docs/RUNBOOK.md ("Cron setup" / "Secrets") for the full walkthrough.
#
# .env is NOT part of the nightly offsite backup (unlike config/ips.yaml,
# #301) — every value below is a live credential. This stays true even
# though that backup is now `age`-encrypted (#320): the exclusion was
# never only about plaintext-vs-encrypted risk, it's architectural (this
# file is read into the `jobs` container via env_file: .env; nothing
# host-side, including the backup push, ever crosses that boundary). Its
# only recovery copy is a plain copy kept current in the private ops doc
# (RUNBOOK.md §10/§14); recreate it by hand after a droplet loss (§7).
# See SECURITY.md's "Why the offsite backup carries policy but not
# secrets" for the full, re-derived reasoning.

# --- app service (compose.yaml) -------------------------------------------

# MUST be the deploy host's Tailscale IP in production — NEVER 0.0.0.0.
# Left blank here on purpose: an unset BIND_ADDR falls back to
# 127.0.0.1 (loopback-only), which fails locked-down rather than open.
# See compose.yaml's ports: comment and RUNBOOK.md §2 (the exposure check).
BIND_ADDR=

# --- build args (compose.yaml build.args; app + jobs) ----------------------

# UID/GID the container runs as (docker-entrypoint.sh), fixed to match the
# deploy host's `deploy` user so the exports/ bind mount is writable by
# both sides — see issue #220 and Dockerfile's ARG APP_UID/APP_GID
# comment. Default 1000 matches the first non-root user a fresh Ubuntu
# `adduser` creates (RUNBOOK.md §1); leave blank/unset if that's true on
# your droplet too. If not, check with `id deploy` and set both here, then
# `docker compose build` (a UID/GID change requires a rebuild, not just a
# restart).
APP_UID=
APP_GID=

# --- jobs service (compose.yaml; docker compose run --rm --no-deps jobs) --

# SMTP relay credentials for the weekly digest email
# (deltadewa/reporting/email_smtp.py). Any standard SMTP relay works —
# Resend, Brevo, Amazon SES, Mailtrap, etc. — so switching providers is a
# config change here, not a code change. SMTP_PORT 465 selects implicit
# TLS/SMTPS; any other port (typically 587) selects STARTTLS. Required
# only when weekly_report.py is run with --send-email; compose.yaml fails
# loudly at `docker compose run` time if these are unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Recipient / verified sender for the weekly digest email.
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=

# Optional (#319) — a friendlier From display name for the digest, so a
# non-technical reader's inbox shows this instead of the raw
# REPORT_EMAIL_FROM address (e.g. a relay-assigned
# deltadewa-a1c2@relay.example.com). REPORT_EMAIL_FROM above is still the
# actual sending address and must stay a verified/allowed sender at the
# relay — this only decorates the header. Defaults to "Weekly Hedge
# Digest" if left unset; not required, and never fails a deploy for
# being unset.
REPORT_EMAIL_FROM_NAME=

# Reserved for future use of FRED's JSON API — the CBOE/FRED CSV endpoints
# this app currently reads don't require a key. Safe to leave blank.
FRED_API_KEY=

# healthchecks.io (or equivalent) check ping URLs — the dead-man's switch.
# See docs/RUNBOOK.md "What each heartbeat alarm means" for what firing
# each one signifies operationally.

# Pings on a full OR partial refresh (exit 0 or 1) — FRED's VIXCLS series
# routinely lags, so a partial refresh is the normal early-morning state,
# not an incident. A total failure (exit 2) does not ping, on purpose.
REFRESH_HEARTBEAT_URL=

# Pings only once the weekly digest email is confirmed sent. This is the
# one where silence is most dangerous — a missing weekly email is exactly
# what gets rationalised as "quiet week" — so an overdue check here must
# alarm, unlike the refresh check above.
DIGEST_HEARTBEAT_URL=

# Pings once the offsite exports/ backup succeeds — including a clean
# "nothing to commit" no-op, which is the normal nightly state, not a
# "didn't run." A push failure does not ping, on purpose (mirrors the
# pattern above). This is the check where silence is most dangerous to
# discover late: you'd find out during a recovery (RUNBOOK §7), when
# it's too late to do anything but restore from an older backup.
#
# NOT read from this file — ops/backup-exports.sh runs from root's
# separate crontab (RUNBOOK §9) and deliberately never reads deploy's
# .env (RUNBOOK §10's credential-boundary rule). Listed here only so all
# three heartbeat URLs are discoverable in one place; set the real value
# via root's crontab env or /etc/deltadewa/backup.env instead — same
# split already used for the backup push credential.
BACKUP_HEARTBEAT_URL=

# The offsite exports/ backup's destination git remote URL (#243) — same
# host-only boundary and same two homes as BACKUP_HEARTBEAT_URL above,
# and for the same reason: ops/backup-exports.sh runs from root's
# crontab, never through the `jobs` container, so it never reads this
# file. Required with no default — the script fails loudly if unset,
# rather than falling back to a hardcoded (and thus publicly-exposed)
# repo. See RUNBOOK.md §10 (or the private ops doc) for the real value.
BACKUP_REMOTE=

# Path to the age recipients file (#320) — one age PUBLIC key per line,
# used to encrypt the nightly backup to two independent recipients (the
# operator's own key, and a second key escrowed for the continuity
# scenario — see docs/continuity-annex.md). Unlike BACKUP_REMOTE/
# BACKUP_HEARTBEAT_URL above, this value isn't sensitive — it's a path
# to a file of PUBLIC keys — so a default is safe to ship
# (/etc/deltadewa/backup-age-recipients.txt); still not read from this
# file for the same structural reason as the other two (root's crontab,
# never the `jobs` container). See RUNBOOK.md §10 for setting up the
# file and both recipients before the first encrypted backup can run.
BACKUP_AGE_RECIPIENTS_FILE=
